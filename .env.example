# --- LLM (OpenAI models through OpenRouter) ---
# Paste your key right after the "=" on the next line (regular API key from https://openrouter.ai/keys,
# starts with sk-or-v1-; management/provisioning keys do not work). Empty = deterministic offline mode.
OPENROUTER_API_KEY=

LLM_MODEL=openai/gpt-6.1-terra
# Optional: minimal | low | medium | high (sent as OpenRouter `reasoning.effort`)
LLM_REASONING_EFFORT=low
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_MS=90000
LLM_MAX_RETRIES=2

# --- News source ---
# local = bundled fixture corpus (deterministic, used by tests); rss = live Google News RSS (no key needed)
NEWS_PROVIDER=local
# Demo knob: make the first N local search calls fail with a transient error to show retries in traces
LOCAL_NEWS_FAIL_FIRST_N=0

# --- Agent budgets ---
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_REPAIRS=2

# --- Advanced ---
# Force the LLM backend: openrouter | offline (NOT a key). Default: openrouter if a key is set, else offline.
# LLM_PROVIDER=offline

# --- Service ---
PORT=3000
RUNS_DIR=runs
# If set, HTTP API requires `Authorization: Bearer <token>` or `x-api-key: <token>`
API_AUTH_TOKEN=
# Include (truncated) prompts/completions in traces. Keep false in shared environments.
TRACE_LLM_PAYLOADS=false
